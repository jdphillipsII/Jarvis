#!/usr/bin/env bash
# Opens a JARVIS window. Both front ends are this script with a different mode.
#
#   jarvis-window app          a normal application window
#   jarvis-window companion    a small pinned window that follows you around
#
# There is no Electron and no Tauri here on purpose. The page is already served
# by the daemon on loopback, so a browser in app mode is a real window with its
# own icon, its own taskbar entry and no second runtime to install or update.
# The two modes differ only in the window class, which is what KWin's rules key
# off — one codebase, two behaviours.
set -euo pipefail

MODE="${1:-app}"
PORT="${JARVIS_PORT:-8787}"
URL="http://127.0.0.1:${PORT}/"

case "$MODE" in
  app)        CLASS=jarvis;           SIZE=1280,860 ;;
  companion)  CLASS=jarvis-companion; SIZE=460,720 ;;
  *) echo "usage: jarvis-window [app|companion]" >&2; exit 2 ;;
esac

awake() { curl -sf --max-time 1 "${URL}api/state" >/dev/null 2>&1; }

wait_awake() {  # wait_awake <half-seconds>
  local tries="$1"
  while [ "$tries" -gt 0 ]; do
    awake && return 0
    sleep 0.5
    tries=$((tries - 1))
  done
  return 1
}

# Clicking an app icon should start the app. If the unit is installed, bring
# it up rather than telling someone to go and do it in a terminal — which is
# the thing a front end exists to stop.
if ! awake; then
  UNIT="$HOME/.config/systemd/user/jarvis.service"
  if systemctl --user cat jarvis.service >/dev/null 2>&1; then
    systemctl --user start jarvis >/dev/null 2>&1 || true
  elif [ -f "$UNIT" ]; then
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    systemctl --user start jarvis >/dev/null 2>&1 || true
  else
    echo "JARVIS is not installed as a service yet." >&2
    echo "  jarvis install" >&2
    echo "  systemctl --user daemon-reload" >&2
    echo "  systemctl --user enable --now jarvis" >&2
    exit 1
  fi

  if ! wait_awake 24; then
    echo "JARVIS did not come up on ${PORT}." >&2
    echo >&2
    # journalctl, not `systemctl status`: a unit in auto-restart shows no log
    # lines in its status, which is exactly when you need them most.
    journalctl --user -u jarvis -n 20 --no-pager 2>&1 | sed 's/^/  /' >&2
    echo >&2
    echo "  run it in the foreground to see why:  jarvis serve" >&2
    exit 1
  fi
fi

for browser in chromium chromium-browser google-chrome brave-browser microsoft-edge; do
  if command -v "$browser" >/dev/null 2>&1; then
    exec "$browser" --app="$URL" --class="$CLASS" --window-size="$SIZE" \
         --user-data-dir="${XDG_DATA_HOME:-$HOME/.local/share}/jarvis/$CLASS"
  fi
done

# Firefox has no --app, but a kiosk-ish window with its own profile is close.
if command -v firefox >/dev/null 2>&1; then
  PROFILE="${XDG_DATA_HOME:-$HOME/.local/share}/jarvis/$CLASS"
  mkdir -p "$PROFILE"
  exec firefox --no-remote --profile "$PROFILE" --class "$CLASS" --new-window "$URL"
fi

echo "no browser found. Open $URL yourself, or install chromium." >&2
exit 1
