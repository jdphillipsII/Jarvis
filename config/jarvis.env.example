# Central config. Source this; don't hardcode these values anywhere else.
JARVIS_AGENCY=actuator          # advisory | actuator | agentic
# Camera. 0 = /dev/video0 (built-in webcam).
# Phone as camera: install "IP Webcam" (Android), start the server, and put
# its URL here — e.g. http://192.168.1.42:8080/video
# Lock focus and exposure in the app; autofocus hunting wrecks hand tracking.
JARVIS_CAM=0
# Fast resident model: banter, wake responses, intent routing.
JARVIS_CHAT_MODEL=qwen2.5:7b
# Handed the hard problems. On 24 GB, Q4 of a ~27B is the sweet spot.
JARVIS_HEAVY_MODEL=qwen2.5:32b
# Reasoning models (Hermes 4, Qwen 3.x) work unmodified — <think> blocks are
# stripped before speech and text-form <tool_call> tags are executed anyway.
# See core/reasoning.py.
JARVIS_VOICE=en_GB-alan-medium  # Piper voice (dry British male)
